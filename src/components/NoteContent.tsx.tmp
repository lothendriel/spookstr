    // Process each media item and the text around it
    sortedMedia.forEach((media) => {
      let mediaIndex = processedText.indexOf(media.url);
      
      // If URL not found, try alternative variations
      if (mediaIndex === -1) {
        const variations = [
          media.url.replace('https://www.', 'https://'),
          media.url.replace('https://www.', 'http://'),
          media.url.replace('https://', 'http://'),
          media.url.endsWith('/') ? media.url.slice(0, -1) : media.url + '/',
        ];
        
        for (const variation of variations) {
          const variationIndex = processedText.indexOf(variation);
          if (variationIndex !== -1) {
            mediaIndex = variationIndex;
            // Update media URL to match what's actually in the text
            media.url = variation;
            break;
          }
        }
      }
      
      // Skip if still not found
      if (mediaIndex === -1) {
        console.warn('Media URL not found in text:', media.url);
        return;
      }

      if (mediaIndex > 0) {
        // Add text before the media URL
        const beforeText = processedText.substring(0, mediaIndex);
        parts.push(...processTextContent(beforeText, keyCounter, skipUrls));
        keyCounter += beforeText.split(/\s+/).length; // Rough estimate for key increment
      }

      // Add the media display component
      parts.push(
        <MediaDisplay
          key={`media-${keyCounter++}`}
          media={media}
        />
      );

      // Remove the processed part from the text
      processedText = processedText.substring(mediaIndex + media.url.length);
    });